# Suite CXO self-hosted box: settings. install.sh copies this to .env and fills
# every "generated" value with a fresh random one. NO real values belong in this
# file or in git: the box's .env is root-only (chmod 600) and its values go on
# the client's build sheet in our password manager, never in the vault.

# --- The box -------------------------------------------------------------
BOX_ID=box                       # short name, e.g. acme-01 (shows in health reports + tailnet)
SITE_HOST=localhost              # what staff type: an IP (192.168.1.50) or a name their DNS serves
ROOT_DOMAIN=localhost
BIND_ADDR=0.0.0.0                # 0.0.0.0 = office LAN. 127.0.0.1 = this machine only (build-box tests)
HTTPS_PORT=443
HTTP_PORT=80
HEALTH_PORT=8099                 # health agent, always on 127.0.0.1

# --- Generated by install.sh (leave blank here) --------------------------
POSTGRES_PASSWORD=
PGRST_AUTHENTICATOR_PASSWORD=
JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=       # HS256 JWT {role: service_role} signed with JWT_SECRET
SESSION_SECRET=
CRON_SECRET=
RESTIC_PASSWORD=
ADMIN_PASSWORD_HASH=             # bcrypt; the plain password goes to selfhost/.admin-password (root-only)

# --- AI (one OpenAI-compatible endpoint) ---------------------------------
# v1 default: OpenRouter. On a GPU box run `--profile local-llm` and set
# LLM_BASE_URL=http://ollama:11434/v1 (or a vLLM URL).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=                     # the client's or our OpenRouter key; blank = AI off
LLM_MODEL_ID=

# --- Backups (restic) -----------------------------------------------------
BACKUP_DIR=./data/backup-repo    # host path of the second disk, e.g. /mnt/backup/suitecxo
RESTIC_REPOSITORY=/backup-repo   # or s3:https://<host>/<bucket>/suitecxo
RESTIC_S3_ACCESS_KEY_ID=
RESTIC_S3_SECRET_ACCESS_KEY=
BACKUP_CRON=30 2 * * *           # nightly, box local time

# --- Our hands (opt-in) ---------------------------------------------------
TS_AUTHKEY=                      # one-off tailnet key, used only with `--profile remote`
HEALTH_REPORT_URL=               # our ops endpoint; blank = report locally only
HEALTH_REPORT_TOKEN=

# --- Client integrations (opt-in) -----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Outgoing mail through the client's own mailbox (Microsoft 365: smtp.office365.com:587,
# Google: smtp.gmail.com:587 with an app password, or their relay). Blank SMTP_HOST = no mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                # true only for port 465 (implicit TLS)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                       # e.g. Ciao <ciao@client.com>, on the client's own domain
SMTP_REPLY_TO=                   # blank = the From address
WORKER_TICK_MS=30000
